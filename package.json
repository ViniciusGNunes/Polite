{
  "name": "polite",
  "version": "1.0.0",
  "description": "Corretor gramatical com IA da Groq",
  "scripts": {
    "dev": "node scripts/run-and-mirror.js dev",
    "build": "node scripts/run-and-mirror.js build",
    "package": "node scripts/package.js",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:firefox": "npm run build:firefox && web-ext lint --source-dir build/firefox-mv3-prod",
    "test:all": "npm test && npm run test:e2e && npm run test:firefox"
  },
  "displayName": "Polite",
  "manifest": {
    "name": "Polite",
    "host_permissions": [
      "https://api.groq.com/*"
    ],
    "permissions": [
      "storage"
    ],
    "commands": {
      "fix-selection": {
        "suggested_key": {
          "default": "Alt+C"
        },
        "description": "Corrigir texto selecionado com IA"
      }
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "polite@viniciusgnunes.github.io",
        "strict_min_version": "115.0"
      }
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@plasmohq/storage": "^1.15.0",
    "antd": "^6.6.4",
    "lucide-react": "^1.46.0",
    "plasmo": "^0.90.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "dotenv": "^18.0.5",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "sass": "^1.105.0",
    "selenium-webdriver": "^4.50.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.2",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0"
  }
}
